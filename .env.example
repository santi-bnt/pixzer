# Public Supabase project values (safe for the browser only with RLS enabled)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Cloudflare R2 credentials. Never expose these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Server-only Supabase service role key (not needed until trusted admin tasks exist)
SUPABASE_SERVICE_ROLE_KEY=
