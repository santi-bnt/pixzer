# Local development: copy this file to .env.local and use the local Supabase URL/key.
# Hosted development/production: use the matching project's API URL and publishable key.
# Public values are safe for the browser only with grants and RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only private Cloudflare R2 credentials. Never expose with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Server-only Supabase secret key used only by upload reservation/completion RPCs.
SUPABASE_SECRET_KEY=

# Keep false until the reviewed private-upload migration is applied to this project
# and the bucket, credentials, and CORS rules have been verified.
PIXZER_R2_UPLOADS_ENABLED=false

# Google Drive is a separate OAuth connection from Supabase Auth.
# Leave disabled until migrations 0003 + 0004 are reviewed/applied and OAuth is configured.
PIXZER_GAME_STORAGE_PROVIDER=google_drive
PIXZER_GOOGLE_DRIVE_ENABLED=false
PIXZER_GOOGLE_DRIVE_UPLOADS_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Generate 32 random bytes and base64-encode them. Server only; encrypts refresh tokens.
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
# Server-only bearer secret for the protected expired-Drive-upload reconciliation endpoint.
PIXZER_DRIVE_RECONCILIATION_SECRET=
